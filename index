            <button onclick="downloadCertificate()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-10 rounded-xl transition shadow-lg flex items-center justify-center mx-auto gap-3 text-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download Official Certificate
            </button>
        </section>

    </main>

    <footer class="bg-slate-900 text-slate-400 py-8 text-center mt-auto border-t border-slate-800">
        <p class="font-bold text-slate-300 mb-2">Level 4 ESA English Lesson</p>
        <p class="text-sm">Interactive methodology for A2-B1 language acquisition.</p>
    </footer>

    <script>
        // Global State
        let studentName = "";
        let timerInterval;
        
        let currentQuizState = 'section-signup';
        let gistTimerStarted = false;

        const tabMapping = {
            'tab-engage': ['section-engage'],
            'tab-input': ['section-study-input'],
            'tab-gist': ['section-study-gist'],
            'tab-detail': ['section-study-detail'],
            'tab-grammar': ['section-grammar'],
            'tab-activate': ['section-activate'],
            'tab-quiz': ['section-signup', 'section-quiz', 'section-certificate']
        };

        function switchTab(tabId, stepNumber) {
            // Update active tab styling
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('tab-active', 'bg-blue-600', 'text-white');
                btn.classList.add('bg-slate-200', 'text-slate-700');
            });
            const activeBtn = document.getElementById(tabId);
            if(activeBtn) {
                activeBtn.classList.add('tab-active', 'bg-blue-600', 'text-white');
                activeBtn.classList.remove('bg-slate-200', 'text-slate-700');
            }

            // Hide all sections
            document.querySelectorAll('section').forEach(sec => sec.classList.add('hidden-section'));

            // Show sections for the selected tab
            const sectionsToShow = tabMapping[tabId];
            if (tabId === 'tab-quiz') {
                document.getElementById(currentQuizState).classList.remove('hidden-section');
            } else {
                sectionsToShow.forEach(secId => {
                    const sec = document.getElementById(secId);
                    if(sec) sec.classList.remove('hidden-section');
                });
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
            updateProgress(stepNumber);
            
            // Trigger timer if Gist tab is opened manually
            if (tabId === 'tab-gist' && !gistTimerStarted) {
                startGistPhase(true); 
            }
        }
        
        // Progress Logic (7 phases now)
        function updateProgress(stepNumber) {
            const progress = (stepNumber / 7) * 100;
            document.getElementById('progress-bar').style.width = `${progress}%`;
        }

        function nextSection(sectionId, stepNumber) {
            const sectionToTab = {
                'section-engage': 'tab-engage',
                'section-study-input': 'tab-input',
                'section-study-gist': 'tab-gist',
                'section-study-detail': 'tab-detail',
                'section-grammar': 'tab-grammar',
                'section-activate': 'tab-activate',
                'section-signup': 'tab-quiz',
                'section-quiz': 'tab-quiz',
                'section-certificate': 'tab-quiz'
            };
            
            const targetTab = sectionToTab[sectionId];
            if(targetTab === 'tab-quiz') {
               currentQuizState = sectionId;
            }
            switchTab(targetTab, stepNumber);
        }

        window.onload = function() {
            setupEngagePhase();
            switchTab('tab-engage', 1);
        };

        // --- PHASE 1: ENGAGE ---
        const vocabItems = [
            { icon: "🚲", hint: "R_ _ _ a B_ _ _", answer: "ride a bike", type: "outdoor" },
            { icon: "📺", hint: "W_ _ _ _ T_", answer: "watch tv", type: "indoor" },
            { icon: "📱", hint: "U_ _ S_ _ _ _ _ M_ _ _ _", answer: "use social media", type: "indoor" },
            { icon: "⚽", hint: "P_ _ _ F_ _ _ _ _ _", answer: "play football", type: "outdoor" }
        ];
        
        let typedVocabWords = [];

        function setupEngagePhase() {
            const zone = document.getElementById('vocab-input-zone');
            vocabItems.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = "bg-slate-50 border border-slate-200 rounded-xl p-4 text-center shadow-sm";
                card.innerHTML = `
                    <div class="text-4xl mb-3">${item.icon}</div>
                    <p class="text-slate-500 font-mono text-sm tracking-widest mb-3">${item.hint}</p>
                    <input type="text" id="vocab-inp-${idx}" class="w-full p-2 border border-slate-300 rounded text-center focus:border-blue-500 outline-none uppercase font-bold text-slate-700" placeholder="Type here...">
                `;
                zone.appendChild(card);
            });
            
            // Add submit button for the typing part
            const btnDiv = document.createElement('div');
            btnDiv.className = "col-span-full text-center mt-4";
            btnDiv.innerHTML = `<button onclick="verifyVocabTyping()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-8 rounded-lg transition shadow-md">Confirm Words</button>
                                <p id="vocab-type-err" class="text-red-500 mt-2 hidden font-medium">Check your spelling! Keep trying.</p>`;
            zone.appendChild(btnDiv);
        }

        function verifyVocabTyping() {
            let allCorrect = true;
            typedVocabWords = [];
            
            vocabItems.forEach((item, idx) => {
                const inp = document.getElementById(`vocab-inp-${idx}`);
                const val = inp.value.toLowerCase().trim();
                // Allow exact match or key words
                const isCorrect = val === item.answer || val.includes(item.answer.split(' ')[0]); 
                
                if(val.length > 2) {
                    inp.classList.remove('border-red-500', 'bg-red-50');
                    inp.classList.add('border-green-500', 'bg-green-50');
                    typedVocabWords.push({ word: item.answer, type: item.type, icon: item.icon });
                } else {
                    inp.classList.add('border-red-500', 'bg-red-50');
                    allCorrect = false;
                }
            });

            if(typedVocabWords.length === 4) {
                document.getElementById('vocab-type-err').classList.add('hidden');
                document.getElementById('vocab-input-zone').classList.add('hidden');
                initSortingPhase();
            } else {
                document.getElementById('vocab-type-err').classList.remove('hidden');
            }
        }

        let engageState = {}; // word -> 'indoor' | 'outdoor'
        
        function initSortingPhase() {
            const sortZone = document.getElementById('sorting-zone');
            sortZone.classList.remove('hidden');
            
            const inZone = document.getElementById('indoor-zone');
            
            typedVocabWords.forEach((item, idx) => {
                engageState[item.word] = 'indoor'; // default start
                const btn = document.createElement('button');
                btn.className = "activity-card w-full bg-white border-2 border-slate-300 p-3 rounded-lg font-bold text-slate-700 flex justify-between items-center";
                btn.innerHTML = `<span>${item.icon} ${item.word.toUpperCase()}</span> <span class="text-xs text-blue-500 border border-blue-200 px-2 rounded bg-blue-50">Move &rightwards_arrow;</span>`;
                
                btn.onclick = () => {
                    const currentState = engageState[item.word];
                    if(currentState === 'indoor') {
                        engageState[item.word] = 'outdoor';
                        btn.querySelector('span:last-child').innerHTML = "&leftwards_arrow; Move";
                        document.getElementById('outdoor-zone').appendChild(btn);
                    } else {
                        engageState[item.word] = 'indoor';
                        btn.querySelector('span:last-child').innerHTML = "Move &rightwards_arrow;";
                        document.getElementById('indoor-zone').appendChild(btn);
                    }
                    updateSortCheckBtn();
                };
                inZone.appendChild(btn);
            });
            updateSortCheckBtn();
        }
        
        function updateSortCheckBtn() {
            document.getElementById('check-engage-btn').classList.remove('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
        }

        function checkEngage() {
            let correct = 0;
            typedVocabWords.forEach(item => {
                if(engageState[item.word] === item.type) correct++;
            });
            
            document.getElementById('engage-feedback').innerText = "Excellent classification! Moving on.";
            document.getElementById('engage-feedback').className = "mt-4 font-bold text-emerald-600 text-lg h-6";
            document.getElementById('next-to-input').classList.remove('hidden');
        }

        // --- PHASE 2: PREDICTION ---
        function checkPredictions() {
            const inputs = document.querySelectorAll('.predict-input');
            let filled = 0;
            inputs.forEach(inp => { if(inp.value.trim().length > 2) filled++; });
            
            if(filled >= 1) {
                document.getElementById('prediction-feedback').classList.remove('hidden');
                document.getElementById('next-to-gist').classList.remove('hidden');
            }
        }

        // --- PHASE 3: GIST (TIMER) ---
        function startGistPhase(fromTabClick = false) {
            if (!fromTabClick) {
                nextSection('section-study-gist', 3);
            }
            
            if (gistTimerStarted) return;
            gistTimerStarted = true;
            
            let timeLeft = 90;
            const display = document.getElementById('timer-display');
            const textContainer = document.getElementById('gist-text-container');
            
            timerInterval = setInterval(() => {
                timeLeft--;
                let m = Math.floor(timeLeft / 60);
                let s = timeLeft % 60;
                display.innerText = `0${m}:${s < 10 ? '0'+s : s}`;
                
                if(timeLeft <= 10) {
                    display.classList.add('text-red-600', 'bg-red-50', 'border-red-200');
                    display.classList.remove('text-emerald-600', 'bg-emerald-50', 'border-emerald-200');
                }
                
                if(timeLeft <= 0) {
                    clearInterval(timerInterval);
                    display.innerText = "TIME UP!";
                    textContainer.style.opacity = "0.2"; // Blur text to force gist answering from memory/skimming
                    textContainer.classList.add('pointer-events-none');
                }
            }, 1000);
        }

        function checkGist(btn, isCorrect) {
            clearInterval(timerInterval); // stop timer if they answer early
            
            document.querySelectorAll('.gist-btn').forEach(b => {
                b.classList.remove('bg-blue-50', 'border-blue-500', 'bg-emerald-50', 'border-emerald-500', 'bg-red-50', 'border-red-500');
                b.classList.add('bg-white', 'border-slate-200');
            });
            
            const feedback = document.getElementById('gist-feedback');
            
            if (isCorrect) {
                btn.classList.add('bg-emerald-50', 'border-emerald-500');
                btn.classList.remove('bg-white', 'border-slate-200');
                feedback.innerText = "Correct! The text contrasts past and present leisure activities.";
                feedback.className = "text-center mt-6 font-bold text-lg h-6 text-emerald-600";
                document.getElementById('next-to-detail').classList.remove('hidden');
                document.getElementById('gist-text-container').style.opacity = "1"; // restore text
            } else {
                btn.classList.add('bg-red-50', 'border-red-500');
                btn.classList.remove('bg-white', 'border-slate-200');
                feedback.innerText = "Not quite. Think about the title 'Then and Now'.";
                feedback.className = "text-center mt-6 font-bold text-lg h-6 text-red-500";
            }
        }

        // --- PHASE 4: DETAIL ---
        const detailItems = [
            { id: 'd1', text: "Rode bikes in town", ans: "Rosa" },
            { id: 'd2', text: "Played football in the street", ans: "Carlos" },
            { id: 'd3', text: "Did not use the internet", ans: "Rosa" },
            { id: 'd4', text: "Read comic books", ans: "Carlos" },
            { id: 'd5', text: "Listened to music", ans: "Both" }
        ];

        function renderDetailChart() {
            const chart = document.getElementById('detail-chart');
            chart.innerHTML = '';
            
            detailItems.forEach(item => {
                const row = document.createElement('div');
                row.className = "flex flex-col md:flex-row justify-between items-center p-3 border border-slate-200 rounded bg-slate-50 gap-4";
                row.innerHTML = `
                    <span class="font-medium text-slate-700 md:w-1/2">${item.text}</span>
                    <div class="flex gap-2 md:w-1/2 justify-end">
                        <button onclick="selectDetail('${item.id}', 'Rosa', this)" class="detail-opt px-4 py-1.5 border border-slate-300 rounded bg-white hover:bg-purple-50 text-sm font-bold text-slate-600">Rosa</button>
                        <button onclick="selectDetail('${item.id}', 'Carlos', this)" class="detail-opt px-4 py-1.5 border border-slate-300 rounded bg-white hover:bg-blue-50 text-sm font-bold text-slate-600">Carlos</button>
                        <button onclick="selectDetail('${item.id}', 'Both', this)" class="detail-opt px-4 py-1.5 border border-slate-300 rounded bg-white hover:bg-emerald-50 text-sm font-bold text-slate-600">Both</button>
                    </div>
                `;
                chart.appendChild(row);
            });
        }
        
        // init chart early
        renderDetailChart();
        
        let detailAnswers = {};
        function selectDetail(id, choice, btnNode) {
            detailAnswers[id] = choice;
            
            // UI update for button group
            const parent = btnNode.parentElement;
            parent.querySelectorAll('.detail-opt').forEach(b => {
                b.classList.remove('bg-purple-600', 'bg-blue-600', 'bg-emerald-600', 'text-white');
                b.classList.add('bg-white', 'text-slate-600');
            });
            
            if(choice === 'Rosa') btnNode.classList.add('bg-purple-600', 'text-white');
            if(choice === 'Carlos') btnNode.classList.add('bg-blue-600', 'text-white');
            if(choice === 'Both') btnNode.classList.add('bg-emerald-600', 'text-white');
            
            checkAllDetails();
        }
        
        function checkAllDetails() {
            let correct = 0;
            detailItems.forEach(item => {
                if(detailAnswers[item.id] === item.ans) correct++;
            });
            
            if(correct === detailItems.length) {
                document.getElementById('detail-feedback').classList.remove('hidden');
                document.getElementById('inference-section').classList.remove('hidden');
            }
        }

        function checkInference(btn, isCorrect) {
            document.querySelectorAll('.inf-btn').forEach(b => {
                b.classList.remove('bg-emerald-100', 'border-emerald-500', 'bg-red-100', 'border-red-500');
            });
            const feedback = document.getElementById('inf-feedback');
            
            if(isCorrect) {
                btn.classList.add('bg-emerald-100', 'border-emerald-500');
                feedback.innerText = "Correct! 'Invented' means creating something new.";
                feedback.className = "mt-4 font-bold text-lg h-6 text-emerald-700";
                document.getElementById('next-to-grammar').classList.remove('hidden');
            } else {
                btn.classList.add('bg-red-100', 'border-red-500');
                feedback.innerText = "Try again. Think about making games out of imagination.";
                feedback.className = "mt-4 font-bold text-lg h-6 text-red-600";
            }
        }

        // --- PHASE 5: GRAMMAR DISCOVERY ---
        function checkGrammarRules() {
            const v1 = document.getElementById('grammar-select-1').value;
            const v2 = document.getElementById('grammar-select-2').value;
            const v3 = document.getElementById('grammar-select-3').value;
            const fb = document.getElementById('grammar-feedback');
            
            if (v1 === 'ed' && v2 === 'change' && v3 === 's') {
                fb.innerText = "Spot on! You understand how to contrast the past and present.";
                fb.className = "mt-4 font-bold text-emerald-600 text-lg h-6";
                document.getElementById('next-to-activate').classList.remove('hidden');
            } else {
                fb.innerText = "Review the examples. Ensure rules for past and present are correct!";
                fb.className = "mt-4 font-bold text-red-500 text-lg h-6";
            }
        }

        // --- PHASE 6: ACTIVATE ---
        function finishActivation() {
            const q1 = document.getElementById('act-q1').value;
            const q2 = document.getElementById('act-q2').value;
            const comp = document.getElementById('act-comp').value;
            const errorMsg = document.getElementById('activate-error');
            
            if(q1.length > 5 && q2.length > 5 && comp.length > 5) {
                errorMsg.classList.add('hidden');
                document.getElementById('activation-feedback').classList.remove('hidden');
            } else {
                errorMsg.classList.remove('hidden');
            }
        }

        // --- PHASE 7: QUIZ & CERTIFICATE ---
        const level4QuizData = [
            // Details
            { q: "1. Where did Rosa spend her childhood?", options: ["In a large city", "In a small town", "On a farm"], answer: 1 },
            { q: "2. Who did Rosa play with after school?", options: ["Her brothers", "Her cousins", "Her classmates"], answer: 1 },
            { q: "3. How often did Rosa's family watch a film together?", options: ["Every evening", "At weekends", "Once a month"], answer: 1 },
            { q: "4. What did Carlos like doing in the street?", options: ["Riding bikes", "Playing football", "Reading comics"], answer: 1 },
            { q: "5. Today, what does Leo enjoy doing?", options: ["Playing online games", "Spending time outdoors", "Listening to the radio"], answer: 0 },
            
            // Vocab / Inference
            { q: "6. Based on the text, what does 'prefer' mean in 'Carlos still prefers spending free time outdoors'?", options: ["To hate something", "To like one thing more than another", "To forget something"], answer: 1 },
            { q: "7. Which activity is considered an INDOOR activity?", options: ["Riding a bike", "Playing football", "Watching TV"], answer: 2 },
            { q: "8. What does 'grew up' mean?", options: ["Became an adult / lived as a child", "Planted a garden", "Moved to a city"], answer: 0 },
            
            // Grammar: Past Simple Affirmative
            { q: "9. Grammar: They _____ their grandparents.", options: ["visit", "visited", "visiting"], answer: 1 },
            { q: "10. Grammar: He _____ playing football.", options: ["love", "loved", "loving"], answer: 1 },
            { q: "11. Grammar: Rosa _____ outside.", options: ["played", "play", "plays"], answer: 0 },
            { q: "12. Grammar (Irregular): Carlos _____ his friends.", options: ["meet", "meeted", "met"], answer: 2 },
            
            // Grammar: Negative & Questions
            { q: "13. Grammar (Negative): Rosa _____ a phone.", options: ["did not use", "did not used", "not used"], answer: 0 },
            { q: "14. Grammar (Negative): Carlos _____ online games in the past.", options: ["did play not", "did not play", "don't played"], answer: 1 },
            { q: "15. Grammar (Question): _____ Carlos live in a city?", options: ["Do", "Was", "Did"], answer: 2 },
            { q: "16. Grammar (Question): What _____ Rosa do at weekends?", options: ["did", "does", "was"], answer: 0 },
            
            // Synthesis / Complex
            { q: "17. Which statement is TRUE?", options: ["Rosa used the internet every day.", "Carlos read comic books.", "Leo hates online games."], answer: 1 },
            { q: "18. Which verb from the text is IRREGULAR?", options: ["invented", "listened", "rode"], answer: 2 },
            { q: "19. Which verb from the text is REGULAR?", options: ["grew", "helped", "met"], answer: 1 },
            { q: "20. How did Carlos and Rosa's past free time contrast with Leo's today?", options: ["They spent more time on screens.", "They spent more time outdoors and without internet.", "They did not have free time."], answer: 1 }
        ];

        function startQuiz() {
            const nameInput = document.getElementById('student-name').value.trim();
            if (nameInput === "") {
                document.getElementById('name-error').classList.remove('hidden');
                return;
            }
            studentName = nameInput;
            document.getElementById('student-display').innerText = `👤 ${studentName}`;
            document.getElementById('student-display').classList.remove('hidden');
            document.getElementById('cert-name').innerText = studentName;
            
            generateQuizUI();
            
            currentQuizState = 'section-quiz';
            switchTab('tab-quiz', 7);
        }

        function generateQuizUI() {
            const form = document.getElementById('quiz-form');
            form.innerHTML = '';
            
            level4QuizData.forEach((item, index) => {
                const qDiv = document.createElement('div');
                qDiv.className = "bg-slate-50 p-5 rounded-xl border border-slate-200";
                
                const qTitle = document.createElement('h3');
                qTitle.className = "font-bold text-lg text-slate-800 mb-4";
                qTitle.innerText = item.q;
                qDiv.appendChild(qTitle);
                
                const optionsDiv = document.createElement('div');
                optionsDiv.className = "grid grid-cols-1 md:grid-cols-3 gap-3";
                
                item.options.forEach((opt, optIndex) => {
                    const label = document.createElement('label');
                    label.className = "flex items-center p-3 rounded-lg border border-slate-300 cursor-pointer hover:bg-blue-50 hover:border-blue-300 transition bg-white";
                    
                    const radio = document.createElement('input');
                    radio.type = "radio";
                    radio.name = `q${index}`;
                    radio.value = optIndex;
                    radio.className = "quiz-radio";
                    
                    const span = document.createElement('span');
                    span.innerText = opt;
                    span.className = "text-slate-700 font-medium";
                    
                    label.appendChild(radio);
                    label.appendChild(span);
                    optionsDiv.appendChild(label);
                });
                
                qDiv.appendChild(optionsDiv);
                form.appendChild(qDiv);
            });
        }

        function submitQuiz() {
            let score = 0;
            let allAnswered = true;
            
            level4QuizData.forEach((item, index) => {
                const selected = document.querySelector(`input[name="q${index}"]:checked`);
                if (!selected) {
                    allAnswered = false;
                } else {
                    if (parseInt(selected.value) === item.answer) {
                        score++;
                    }
                }
            });

            if (!allAnswered) {
                document.getElementById('quiz-error').classList.remove('hidden');
                return;
            }
            
            document.getElementById('quiz-error').classList.add('hidden');
            
            const percentage = Math.round((score / level4QuizData.length) * 100);
            
            document.getElementById('final-score').innerText = `${percentage}%`;
            document.getElementById('cert-score-text').innerText = `${percentage}%`;
            const today = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            document.getElementById('cert-date').innerText = today;
            
            currentQuizState = 'section-certificate';
            switchTab('tab-quiz', 7);
            
            // Pre-render canvas
            drawCanvasCertificate(percentage, today);
        }

        // --- CERTIFICATE RENDERER ---
        function drawCanvasCertificate(score, dateStr) {
            const canvas = document.getElementById('certCanvas');
            const ctx = canvas.getContext('2d');
            
            // Base background
            ctx.fillStyle = "#fefce8"; // yellow-50
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            // Draw double border
            ctx.strokeStyle = "#eab308"; // yellow-500
            ctx.lineWidth = 14;
            ctx.strokeRect(30, 30, canvas.width - 60, canvas.height - 60);
            ctx.strokeStyle = "#ca8a04"; // yellow-600
            ctx.lineWidth = 3;
            ctx.strokeRect(50, 50, canvas.width - 100, canvas.height - 100);

            // Title
            ctx.fillStyle = "#854d0e"; // yellow-800
            ctx.font = "bold 52px 'Comic Neue', Arial";
            ctx.textAlign = "center";
            ctx.fillText("CERTIFICATE OF ACHIEVEMENT", canvas.width / 2, 140);
            
            // Line separator
            ctx.beginPath();
            ctx.moveTo(canvas.width/2 - 250, 160);
            ctx.lineTo(canvas.width/2 + 250, 160);
            ctx.strokeStyle = "#fde047";
            ctx.lineWidth = 2;
            ctx.stroke();

            // Text
            ctx.fillStyle = "#475569"; // slate-600
            ctx.font = "italic 24px 'Inter', Arial";
            ctx.fillText("This is proudly presented to", canvas.width / 2, 220);
            
            // Name Area
            ctx.fillStyle = "#0f172a"; // slate-900
            ctx.font = "bold 56px 'Inter', Arial";
            ctx.fillText(studentName, canvas.width / 2, 300);
            
            ctx.beginPath();
            ctx.moveTo(canvas.width / 2 - 300, 320);
            ctx.lineTo(canvas.width / 2 + 300, 320);
            ctx.strokeStyle = "#cbd5e1";
            ctx.lineWidth = 2;
            ctx.stroke();

            // Course text
            ctx.fillStyle = "#475569";
            ctx.font = "24px 'Inter', Arial";
            ctx.fillText("for outstanding performance in", canvas.width / 2, 380);
            
            ctx.fillStyle = "#047857"; // emerald-700
            ctx.font = "bold 34px 'Inter', Arial";
            ctx.fillText("Level 4 - English: Free Time Then and Now", canvas.width / 2, 430);

            // Footer Elements
            // Score
            ctx.fillStyle = "#94a3b8"; // slate-400
            ctx.font = "bold 16px 'Inter', Arial";
            ctx.fillText("SCORE ACHIEVED", canvas.width / 4, 520);
            ctx.fillStyle = "#2563eb"; // blue-600
            ctx.font = "bold 38px 'Inter', Arial";
            ctx.fillText(score + "%", canvas.width / 4, 560);

            // Badge Graphic
            ctx.fillStyle = "#facc15"; // yellow-400
            ctx.beginPath();
            ctx.arc(canvas.width / 2, 530, 45, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = "#ffffff";
            ctx.lineWidth = 6;
            ctx.stroke();
            // Drop shadow effect for badge border roughly
            ctx.strokeStyle = "#ca8a04";
            ctx.lineWidth = 2;
            ctx.stroke();
            
            ctx.fillStyle = "#854d0e";
            ctx.font = "40px Arial";
            ctx.fillText("🏆", canvas.width / 2, 545);

            // Date
            ctx.fillStyle = "#94a3b8";
            ctx.font = "bold 16px 'Inter', Arial";
            ctx.fillText("DATE", (canvas.width / 4) * 3, 520);
            ctx.fillStyle = "#334155";
            ctx.font = "bold 28px 'Inter', Arial";
            ctx.fillText(dateStr, (canvas.width / 4) * 3, 555);
        }

        function downloadCertificate() {
            const canvas = document.getElementById('certCanvas');
            const dataURL = canvas.toDataURL('image/png');
            
            const a = document.createElement('a');
            a.href = dataURL;
            const safeName = studentName.replace(/[^a-z0-9]/gi, '_').toLowerCase() || 'student';
            a.download = `Level4_Certificate_${safeName}.png`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
    </script>
</body>
</html>
