            <div class="mt-8">
                <input type="text" id="student-name" placeholder="E.g., Maria Garcia" class="w-full px-6 py-4 border-2 border-slate-300 rounded-xl focus:outline-none focus:border-blue-500 text-xl mb-4 text-center transition-colors shadow-sm font-medium">
                <p id="name-error" class="text-red-500 text-sm hidden mb-4 font-bold bg-red-50 py-2 rounded">Please enter your full name to continue.</p>
                <button onclick="startQuiz()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-6 rounded-xl transition-transform transform active:scale-95 text-xl shadow-lg">
