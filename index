                    <p class="text-xl text-slate-700 mb-3">for outstanding performance in</p>
                    <p class="text-2xl font-bold text-emerald-700 mb-10">Level 4 - English: Free Time Then and Now</p>
                    
                    <div class="grid grid-cols-3 gap-4 items-end mt-12 border-t border-slate-200 pt-6">
                        <div>
                            <p class="text-sm text-slate-500 mb-1 uppercase font-bold tracking-wider">Score Achieved</p>
                            <p id="cert-score-text" class="text-3xl font-bold text-blue-600">100%</p>
                        </div>
                        <div class="flex flex-col items-center">
                            <div class="w-20 h-20 bg-gradient-to-br from-yellow-300 to-yellow-500 rounded-full flex items-center justify-center shadow-lg border-4 border-white mb-2 relative">
                                <span class="text-3xl absolute">🏆</span>
                            </div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Verified</p>
                        </div>
                        <div>
                            <p class="text-sm text-slate-500 mb-1 uppercase font-bold tracking-wider">Date</p>
                            <p id="cert-date" class="text-xl font-bold text-slate-700">Date</p>
