                <div class="mt-8 text-center">
                    <button id="next-to-signup" onclick="nextSection('section-signup', 7)" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 px-12 rounded-full transition shadow-xl text-xl animate-bounce">Ready for Final Evaluation 📝</button>
                </div>
            </div>
